# Copy this file to .env and fill in your own Supabase project values
# Find these in your Supabase dashboard: Project Settings -> API

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The "anon" public key (safe-ish, used to verify incoming JWTs)
SUPABASE_ANON_KEY=

# The "service_role" key (SECRET! server-only, bypasses Row Level Security)
SUPABASE_SERVICE_ROLE_KEY=

# Port the Express server runs on
PORT=3000
