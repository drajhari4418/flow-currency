SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000

# --- Task due-date reminders ---
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc).
# Leave these blank to disable reminder emails — the in-app "due tomorrow"
# banner on the dashboard still works without them.
SMTP_HOST=dushyantkaushik12@gmail.com
SMTP_PORT=587
SMTP_USER=dushyantkaushik12@gmail.com
SMTP_PASS=123456
SMTP_FROM=dushyantkaushik12@gmail.com

# Optional: lets you manually trigger the reminder job for testing via
# POST /api/tasks-internal/send-reminders?key=<this value>
# Leave blank in production to disable that route entirely.
REMINDER_TEST_KEY=trip
